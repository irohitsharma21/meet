# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="AI Meeting Platform"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development   # development | staging | production

# ─── Security (REQUIRED) ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_JWT_SECRET_KEY_MIN_32_CHARS

# ─── MongoDB (REQUIRED) ─────────────────────────────────────────────────────
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ai_meeting_platform

# ─── LiveKit (REQUIRED) ─────────────────────────────────────────────────────
# Get from: https://cloud.livekit.io/
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# ─── Groq API (REQUIRED) ────────────────────────────────────────────────────
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama3-70b-8192
GROQ_LLM_FAST_MODEL=llama3-8b-8192

# ─── Google Calendar OAuth2 (optional) ──────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/
# Enable: Google Calendar API + Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/oauth2callback

# ─── AES-256 Field Encryption (optional, recommended for production) ─────────
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
